{
  "$defs": {
    "dlq": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_retries": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "encoding": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "json",
            "jsonl",
            "native",
            "avro",
            "protobuf"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "retry": {
      "additionalProperties": false,
      "properties": {
        "backoff_ms": {
          "minimum": 0,
          "type": "integer"
        },
        "max_retries": {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "sink_inbox": {
      "additionalProperties": false,
      "description": "PostgreSQL inbox in the local catalog; postgres_url selects a remote inbox.",
      "properties": {
        "inbox": {
          "minLength": 1,
          "type": "string"
        },
        "postgres_url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "inbox"
      ],
      "type": "object"
    },
    "sink_kafka": {
      "additionalProperties": false,
      "description": "Apache Kafka outbound sink.",
      "not": {
        "required": [
          "topic",
          "topic_template"
        ]
      },
      "properties": {
        "brokers": {
          "minLength": 1,
          "type": "string"
        },
        "topic": {
          "minLength": 1,
          "type": "string"
        },
        "topic_template": {
          "default": "{stream_table}",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "brokers"
      ],
      "type": "object"
    },
    "sink_nats": {
      "additionalProperties": false,
      "description": "NATS JetStream outbound sink.",
      "not": {
        "required": [
          "subject",
          "subject_template"
        ]
      },
      "properties": {
        "subject": {
          "minLength": 1,
          "type": "string"
        },
        "subject_template": {
          "default": "{outbox}.{op}",
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "sink_pg_outbox": {
      "additionalProperties": false,
      "description": "Deprecated PostgreSQL inbox alias; use sink_type 'inbox' with postgres_url.",
      "properties": {
        "inbox": {
          "minLength": 1,
          "type": "string"
        },
        "postgres_url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "inbox",
        "postgres_url"
      ],
      "type": "object"
    },
    "sink_webhook": {
      "additionalProperties": false,
      "description": "HTTPS webhook outbound sink.",
      "oneOf": [
        {
          "properties": {
            "allow_http": {
              "const": true
            },
            "url": {
              "pattern": "^https?://"
            }
          },
          "required": [
            "allow_http"
          ]
        },
        {
          "not": {
            "required": [
              "allow_http"
            ]
          },
          "properties": {
            "url": {
              "pattern": "^https://"
            }
          }
        },
        {
          "properties": {
            "allow_http": {
              "const": false
            },
            "url": {
              "pattern": "^https://"
            }
          },
          "required": [
            "allow_http"
          ]
        }
      ],
      "properties": {
        "allow_http": {
          "default": false,
          "type": "boolean"
        },
        "signing_algorithm": {
          "default": "hmac-sha256",
          "enum": [
            "hmac-sha256"
          ],
          "type": "string"
        },
        "signing_secret": {
          "pattern": "^\\$\\{(?:env|file):[^}]+\\}$",
          "type": "string"
        },
        "ssrf_protection": {
          "default": true,
          "type": "boolean"
        },
        "timeout_secs": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        },
        "url": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "source_outbox": {
      "additionalProperties": false,
      "description": "Native PostgreSQL outbox source.",
      "properties": {
        "consumer_group": {
          "minLength": 1,
          "type": "string"
        },
        "consumer_id": {
          "default": "pg-tide",
          "minLength": 1,
          "type": "string"
        },
        "outbox": {
          "minLength": 1,
          "type": "string"
        },
        "subject_template": {
          "default": "{outbox}.{op}",
          "minLength": 1,
          "type": "string"
        },
        "visibility_seconds": {
          "default": 30,
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "outbox"
      ],
      "type": "object"
    }
  },
  "$id": "https://pg-tide.dev/schemas/pipeline-config-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "sink_type": {
            "const": "inbox"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": {
            "maximum": 1000
          },
          "sink": {
            "$ref": "#/$defs/sink_inbox"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sink_type": {
            "const": "pg_outbox"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": {
            "maximum": 1000
          },
          "sink": {
            "$ref": "#/$defs/sink_pg_outbox"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sink_type": {
            "const": "nats"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": {
            "maximum": 100
          },
          "sink": {
            "$ref": "#/$defs/sink_nats"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sink_type": {
            "const": "kafka"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": {
            "maximum": 100
          },
          "sink": {
            "$ref": "#/$defs/sink_kafka"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sink_type": {
            "const": "webhook"
          }
        }
      },
      "then": {
        "properties": {
          "batch_size": {
            "maximum": 100
          },
          "sink": {
            "$ref": "#/$defs/sink_webhook"
          }
        }
      }
    }
  ],
  "properties": {
    "batch_size": {
      "maximum": 1000000,
      "minimum": 1,
      "type": "integer"
    },
    "dlq": {
      "$ref": "#/$defs/dlq"
    },
    "encoding": {
      "$ref": "#/$defs/encoding"
    },
    "retry": {
      "$ref": "#/$defs/retry"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "type": "integer"
    },
    "sink": {
      "type": "object"
    },
    "sink_type": {
      "enum": [
        "inbox",
        "kafka",
        "nats",
        "pg_outbox",
        "webhook"
      ],
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/source_outbox"
    },
    "source_type": {
      "enum": [
        "outbox"
      ],
      "type": "string"
    },
    "transforms": {
      "type": "array"
    }
  },
  "required": [
    "source_type",
    "source",
    "sink_type",
    "sink"
  ],
  "title": "pg_tide pipeline configuration v1",
  "type": "object"
}
